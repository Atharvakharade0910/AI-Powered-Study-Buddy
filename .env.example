GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# Text, document-grounded chat, and quiz generation.
GEMINI_MODEL=gemini-3.6-flash
# Native audio Live API model; Gemini 3.6 Flash is not Live API-compatible.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
COOKIE_SECURE=0
STUDY_BUDDY_DB=data/study_buddy.db
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
LOG_LEVEL=INFO
APP_ENV=development
# Production deployment uses PostgreSQL and Redis. Leave these blank for the
# local SQLite/dev mode.
DATABASE_URL=
REDIS_URL=
# Optional S3-compatible object storage for original uploaded PDFs.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Maximum concurrent document jobs per process in local mode.
DOCUMENT_WORKERS=2
# Phone verification: use dev for local development or twilio for SMS delivery.
SMS_PROVIDER=dev
PHONE_VERIFICATION_DEV_MODE=1
TWILIO_ACCOUNT_SID=
# Use either an API key pair or the legacy Auth Token. API keys are preferred.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
